# Server configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# Example: mongodb+srv://admin:MySecurePassword@cluster0.abcde.mongodb.net/queuecounter?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/queuecounter?retryWrites=true&w=majority
